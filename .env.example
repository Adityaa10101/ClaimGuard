# ──────────────────────────────────────────────────────────
# ClaimGuard — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# WARNING: Do NOT commit the .env file to version control.
# ──────────────────────────────────────────────────────────

# Groq API key for LLM-based narrative extraction.
# If not set, the extractor falls back to deterministic regex parsing.
GROQ_API_KEY=

# Comma-separated list of allowed CORS origins for the FastAPI API.
# Defaults to localhost development origins if not set.
CLAIMGUARD_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:8000
